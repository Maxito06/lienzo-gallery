# Base de datos (Neon)
# Conexión con pooling: la usa la API en ejecución
DATABASE_URL=
# Conexión directa (sin pooling): la usa Prisma para las migraciones
DIRECT_URL=

# Base de datos de pruebas: rama "test" de Neon, conexión directa. Nunca debe ser la de DATABASE_URL, porque las pruebas borran los datos.
TEST_DATABASE_URL=

# Imágenes (Cloudinary)
CLOUDINARY_CLOUD_NAME=txpt4qqx
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=lienzo_artworks

# Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
